+#if defined(ARM64_BOARD_CONFIG_B2L)
+		{
+			/* Userspace capability reporting only (MobileGestalt/installd
+			 * "arm64e"; MIInstallerErrorDomain 67 otherwise). arm64e images
+			 * already execute through the kernel compat path; exec grading
