# Local upstream checkouts, build products and firmware inputs
xnu/
Build/
build/
out/
*.efi
*.img
*.ipsw
*.dmg
*.im4p
*.kernelcache
*.kc
*.dtb
# Board DTBs sanitized with tools/b1l/sanitize-dtb.py (no /chosen identifiers)
!boards/*/*.dtb
*.fd
.DS_Store

__pycache__/
*.pyc
/userspace/wallpaper/*.jpg

# Logs, backups and editor leftovers from the build/flash loop
*.log
*.bak
*.*bak
*.before-*
*.orig
*.v1
*.tmp
progress/

# Device-specific data that must never be published
wifi.conf
*-calib.bin
*.blob
*.nvram
device-s10/
vendor-audio/
.env

# Apple binaries extracted from the IPSW
dyld_shared_cache*
*.dylib
device-s10e/
