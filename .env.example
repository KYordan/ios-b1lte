# Copy to .env (never committed) or export these before running tools/b1l/*.sh.
# Every variable has a default that matches the original layout.

# Working folder holding this repository's checkouts, IPSW, build outputs and device data
S10_PORT=$HOME/Developer/s10-port
# Root of this repository (the scripts default to $S10_PORT/beyond2lte-ios)
B2L_ROOT=$S10_PORT/beyond2lte-ios
# Android platform-tools adb
ADB=$HOME/Developer/android/platform-tools/adb
# adb serial of the phone; leave empty when only one device is connected
B2L_SERIAL=
# Python/LLVM environment (python3, llvm-mc)
PY_ENV=$HOME/Developer/tools/mamba/envs/s10
